{
  "emulators": [
    {
      "id": "dolphin",
      "name": "Dolphin",
      "description": "Nintendo Wii and GameCube",
      "flatpak": "org.DolphinEmu.dolphin-emu",
      "folders": [
        "wii",
        "gamecube"
      ],
      "extensions": [
        "iso",
        "rvz",
        "wbfs",
        "gcm",
        "ciso",
        "gcz",
        "wia",
        "wad"
      ],
      "args": [
        "-b",
        "-C",
        "Dolphin.Display.Fullscreen=True",
        "-e",
        "{rom}"
      ],
      "windows": {
        "exe": "Dolphin.exe",
        "dirs": [
          "%ProgramFiles%/Dolphin",
          "%ProgramFiles%/Dolphin Emulator",
          "%LOCALAPPDATA%/Dolphin",
          "%USERPROFILE%/Dolphin-x64",
          "%USERPROFILE%/Dolphin",
          "%USERPROFILE%/scoop/apps/dolphin/current",
          "C:/Dolphin-x64"
        ],
        "download": "https://dolphin-emu.org/download/"
      }
    },
    {
      "id": "ryujinx",
      "name": "Ryujinx (Ryubing)",
      "description": "Nintendo Switch, community-maintained Ryujinx (needs prod.keys and firmware)",
      "flatpak": "io.github.ryubing.Ryujinx",
      "folders": [
        "switch"
      ],
      "extensions": [
        "nsp",
        "xci",
        "nca",
        "nro",
        "nso"
      ],
      "args": [
        "{rom}"
      ],
      "windows": {
        "exe": "Ryujinx.exe",
        "dirs": [
          "%ProgramFiles%/Ryujinx",
          "%LOCALAPPDATA%/Ryujinx",
          "%USERPROFILE%/Ryujinx",
          "%USERPROFILE%/scoop/apps/ryujinx/current",
          "C:/Ryujinx"
        ],
        "download": "https://ryujinx.app/download",
        "release": [
          { "api": "https://git.ryujinx.app/api/v1/repos/ryubing/ryujinx/releases/latest", "asset": "win.*x64.*\\.zip$" },
          { "query": "https://update.ryujinx.app/download/query?os=win&arch=x64&rc=stable" }
        ]
      }
    }
  ]
}
