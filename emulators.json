{
  "emulators": [
    {
      "id": "dolphin",
      "name": "Dolphin",
      "description": "Nintendo Wii and GameCube",
      "flatpak": "org.DolphinEmu.dolphin-emu",
      "folders": [
        "wii",
        "gamecube"
      ],
      "extensions": [
        "iso",
        "rvz",
        "wbfs",
        "gcm",
        "ciso",
        "gcz",
        "wia",
        "wad"
      ],
      "args": [
        "-b",
        "-e",
        "{rom}"
      ]
    },
    {
      "id": "ryujinx",
      "name": "Ryujinx (Ryubing)",
      "description": "Nintendo Switch, community-maintained Ryujinx (needs prod.keys and firmware)",
      "flatpak": "io.github.ryubing.Ryujinx",
      "folders": [
        "switch"
      ],
      "extensions": [
        "nsp",
        "xci",
        "nca",
        "nro",
        "nso"
      ],
      "args": [
        "{rom}"
      ]
    }
  ]
}
