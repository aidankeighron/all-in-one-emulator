{
  "name": "emulator-menu",
  "version": "1.0.0",
  "description": "Wii-style menu that launches Dolphin (Wii/GameCube) and Ryujinx (Switch) on Linux and Windows",
  "author": "aidankeighron",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/aidankeighron/all-in-one-emulator.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "server": "node ui/server.js",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win portable",
    "build": "node scripts/build.js",
    "build:win": "node scripts/build.js win",
    "build:linux": "node scripts/build.js linux"
  },
  "dependencies": {
    "node-unrar-js": "^2.0.2",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aidankeighron.emulatormenu",
    "productName": "Emulator Menu",
    "files": [
      "electron/**",
      "ui/**",
      "emulators.json",
      "package.json"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "ui/assets/icon.png"
    },
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "ui/assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Emulator Menu",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Emulator-Menu-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Emulator-Menu-Portable-${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  }
}
