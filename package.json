{
  "name": "emulator-menu",
  "version": "1.0.0",
  "description": "Wii-style menu that launches Dolphin (Wii/GameCube) and Ryujinx (Switch)",
  "author": "aidankeighron",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/aidankeighron/all-in-one-emulator.git" },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "server": "node ui/server.js",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aidankeighron.emulatormenu",
    "productName": "Emulator Menu",
    "files": [
      "electron/**",
      "ui/**",
      "emulators.json",
      "package.json"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "ui/assets/icon.png"
    },
    "afterPack": "scripts/after-pack.js"
  }
}
